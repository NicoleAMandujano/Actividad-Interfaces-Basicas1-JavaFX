<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.niki.numeros.PrimaryController">
   <children>
      <!-- Fila de entrada de datos -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="Ingrese un número:" />
            <TextField fx:id="txtNumero" />
            <Button fx:id="btnAnalizar" onAction="#analizar" text="Analizar" />
            <Button fx:id="btnLimpiar" onAction="#limpiar" text="Limpiar" />
         </children>
      </HBox>

      <!-- Campos de resultados -->
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label text="Cantidad de cifras:" />
                  <TextField fx:id="txtCantidad" editable="false" />
                  <Label text="Suma impares:" />
                  <TextField fx:id="txtSumaImpares" editable="false" />
                  <Label text="Suma pares:" />
                  <TextField fx:id="txtSumaPares" editable="false" />
                  <Label text="Suma total:" />
                  <TextField fx:id="txtSumaTotal" editable="false" />
                  <Label text="Cifra mayor:" />
                  <TextField fx:id="txtMayor" editable="false" />
                  <Label text="Cifra menor:" />
                  <TextField fx:id="txtMenor" editable="false" />
               </children>
            </VBox>
            

            <VBox spacing="5.0">
               <children>
                  <Label text="Divisores:" />
                  <TextArea fx:id="txtDivisores" editable="false" prefHeight="200.0" prefWidth="150.0" />
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
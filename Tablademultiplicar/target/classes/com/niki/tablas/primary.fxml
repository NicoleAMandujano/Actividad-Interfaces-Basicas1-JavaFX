<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.niki.tablas.PrimaryController">
   <children>
      <HBox alignment="CENTER" spacing="15.0" layoutX="25.0" layoutY="25.0">
         <children>
            <VBox alignment="CENTER_LEFT" spacing="5.0">
               <children>
                  <Label text="Tabla del:" />
                  <TextField fx:id="txtNumero" />
               </children>
            </VBox>
            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <Button onAction="#calcular" text="Calcular" />
                  <Button onAction="#limpiar" text="Limpiar" />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <TextArea fx:id="txtTabla" layoutX="25.0" layoutY="95.0" prefHeight="310.0" prefWidth="300.0" />
   </children>
</AnchorPane>

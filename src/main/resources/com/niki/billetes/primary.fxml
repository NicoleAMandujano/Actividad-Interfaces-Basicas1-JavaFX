<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.niki.billetes.PrimaryController">
   <children>
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <Label text="dinero:" />
            <TextField fx:id="txtDinero" />
            <Button fx:id="btnLimpiar" onAction="#limpiar" text="x" />
            <Button fx:id="btnDesglose" onAction="#desglosar" text="desglose" />
         </children>
      </HBox>
      
      <HBox alignment="CENTER" spacing="10.0">
         <children>
            <TextArea fx:id="txtDenominaciones" editable="false" />
            <TextArea fx:id="txtCantidades" editable="false" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
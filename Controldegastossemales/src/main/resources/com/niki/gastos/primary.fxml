<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.niki.gastos.PrimaryController">
   <children>
      <Label text="Control de Gastos Semanales" />
      
      <HBox alignment="CENTER" spacing="30.0">
         <children>
            <VBox spacing="10.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Alimentación" />
                        <TextField fx:id="txtAlimentacion" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Refrigerios" />
                        <TextField fx:id="txtRefrigerios" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Transporte" />
                        <TextField fx:id="txtTransporte" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Telefonía" />
                        <TextField fx:id="txtTelefonia" />
                     </children>
                  </HBox>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <Label text="Otros" />
                        <TextField fx:id="txtOtros" />
                     </children>
                  </HBox>
               </children>
            </VBox>

           
            <VBox spacing="10.0">
               <children>
                  <Label text="Estadísticas" />
                  <Label text="Total semanal" />
                  <TextField fx:id="txtTotal" />
                  <Label text="Gasto más alto" />
                  <TextField fx:id="txtMayor" />
               </children>
            </VBox>
         </children>
      </HBox>
   
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button onAction="#calcular" text="Calcular estadísticas" />
            <Button onAction="#limpiar" text="Limpiar" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>

